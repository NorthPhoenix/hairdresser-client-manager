<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- One-time Contact Import of a contact the Stylist picks. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- 'Remind all' sends the Client Reminders from the phone. Asked for when the Stylist first uses it; without it each reminder opens in the SMS app. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Not required: a tablet without a mobile radio installs the app too, and its reminders open in the SMS app. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".HcmApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hcm">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="locale|layoutDirection"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"
            xmlns:tools="http://schemas.android.com/tools">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Remembers the chosen app language on Android versions before 13, which have no system setting for it. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Shares camera captures with the camera app and Share Images with other apps. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
