{
  "expo": {
    "name": "Hairdresser Client Manager",
    "slug": "hairdresser-client-manager",
    "scheme": "hcm",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@clerk/expo",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Hairdresser Client Manager to import selected client contact details."
        }
      ]
    ],
    "android": {
      "package": "com.northphoenix.hairdresserclientmanager"
    }
  }
}
