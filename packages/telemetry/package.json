{
  "name": "@hcm/telemetry",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./testing": {
      "types": "./dist/testSupport.d.ts",
      "default": "./dist/testSupport.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.2",
    "@opentelemetry/instrumentation": "0.223.2",
    "@opentelemetry/resources": "2.12.1",
    "@opentelemetry/sdk-logs": "0.223.2",
    "@opentelemetry/sdk-metrics": "2.12.1",
    "@opentelemetry/sdk-trace-base": "2.12.1",
    "@prisma/instrumentation": "7.8.0",
    "@vercel/otel": "2.3.0"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "2.12.1",
    "@opentelemetry/core": "2.12.1",
    "@types/node": "^25.9.3",
    "typescript": "latest",
    "vitest": "latest"
  }
}
