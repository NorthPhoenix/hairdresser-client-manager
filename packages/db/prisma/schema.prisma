generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  ru
  en
}

enum AppointmentStatus {
  scheduled
  completed
  canceled
  noShow
}

enum AppointmentLocationType {
  inSalon
  atHome
}

enum AppointmentPhotoCategory {
  before
  after
  other
}

enum AppointmentPhotoStatus {
  pendingUpload
  stored
  failed
}

model Stylist {
  id                    String    @id @default(cuid())
  clerkId               String    @unique
  language              Language  @default(ru)
  timezone              String
  salonAddress          String?
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  clients Client[]
  appointments Appointment[]
  serviceMenuItems ServiceMenuItem[]
}

model Client {
  id           String   @id @default(cuid())
  stylistId    String
  name         String
  language     Language @default(ru)
  phone        String?
  email        String?
  address      String?
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stylist       Stylist        @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  primaryAppointments Appointment[] @relation("AppointmentPrimaryClient")
  appointmentParticipants AppointmentParticipant[]
  appointmentServices AppointmentService[]
  appointmentPhotos AppointmentPhoto[]
  profileShares ProfileShare[]
}

model Appointment {
  id           String                  @id @default(cuid())
  stylistId    String
  primaryClientId String
  startsAt     DateTime
  endsAt       DateTime?
  status       AppointmentStatus       @default(scheduled)
  locationType AppointmentLocationType @default(inSalon)
  locationAddress String?
  note         String?
  finalTotalCentsOverride Int?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  stylist       Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  primaryClient Client  @relation("AppointmentPrimaryClient", fields: [primaryClientId], references: [id], onDelete: Restrict)
  participants  AppointmentParticipant[]
  services      AppointmentService[]
  photos        AppointmentPhoto[]
}

model AppointmentParticipant {
  id            String      @id @default(cuid())
  appointmentId String
  clientId      String
  createdAt     DateTime    @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, clientId])
}

model ServiceMenuItem {
  id                String   @id @default(cuid())
  stylistId         String
  name              String
  defaultPriceCents Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stylist Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)
}

model AppointmentService {
  id             String   @id @default(cuid())
  appointmentId  String
  clientId       String
  menuItemId     String?
  name           String
  priceCents     Int      @default(0)
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  colorFormulas ColorFormula[]
}

model ColorFormula {
  id                   String   @id @default(cuid())
  appointmentServiceId String
  formula              String
  placement            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  appointmentService AppointmentService @relation(fields: [appointmentServiceId], references: [id], onDelete: Cascade)
}

model AppointmentPhoto {
  id            String                  @id @default(cuid())
  appointmentId String
  clientId      String
  category      AppointmentPhotoCategory @default(other)
  status        AppointmentPhotoStatus   @default(pendingUpload)
  provider      String                  @default("uploadthing")
  fileKey       String?
  url           String?
  thumbnailUrl  String?
  width         Int?
  height        Int?
  uploadError   String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ProfileShare {
  id        String   @id @default(cuid())
  clientId  String
  token     String   @unique
  language  Language @default(ru)
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}
