# Clerk (the Android app reads the publishable key from apps/android/local.properties)
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# PostgreSQL (Neon). These two go in packages/db/.env.
# DATABASE_URL: what the app connects with (on Neon, the pooled "-pooler" connection string).
# DATABASE_URL_UNPOOLED: optional direct connection string, used by `pnpm db:push` when set.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# UploadThing Appointment Photos
UPLOADTHING_TOKEN=
UPLOADTHING_CALLBACK_URL=
